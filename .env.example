# Ausschließlich lokale Platzhalter. Niemals echte Zugangsdaten eintragen oder committen.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://fahrseiten_local:local_only@127.0.0.1:3306/fahrseiten_local
FAHRSEITEN_CONFIG_FILE=
TRUST_PROXY_HEADERS=false
MARKETING_HOSTS=localhost,127.0.0.1,fahrseiten.de,www.fahrseiten.de
APP_HOSTS=app.localhost,app.fahrseiten.de
DEMO_HOSTS=demo.localhost,demo.fahrseiten.de,demo.fahrseiten.local
DEMO_DATA_MODE=fixture
SMTP_MODE=catch
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FahrSeiten Lokal <noreply@fahrseiten.local>
CRON_SECRET=replace-with-a-random-local-secret
INSTALL_TOKEN=replace-with-a-random-local-install-token
CONSENT_FUNCTIONAL_SERVICES=
CONSENT_STATISTICS_SERVICES=
CONSENT_MARKETING_SERVICES=

# Optional: Onlinebrief24. Zugangsdaten nur in Plesk speichern.
ONLINEBRIEF_MODE=test
ONLINEBRIEF_API_KEY=
ONLINEBRIEF_API_SECRET=
